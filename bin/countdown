#!/bin/bash
shopt -qs extglob

readonly scriptDir="$([ "${BASH_SOURCE[0]}" ] && dirname -- "${BASH_SOURCE[0]}" || exit 3)"
[ -d "$scriptDir" ] || { echo >&2 'ERROR: Cannot determine script directory!'; exit 3; }
readonly projectDir="${scriptDir}/.."

export DURATIONWITHADJUSTMENTTOSECONDS_ACCEPT_FRACTIONAL=t DURATIONTOSECONDS_ACCEPT_FRACTIONAL=t

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: %q %s\n' "$(basename "$1")" "[--prefix TEXT] [--as dot|ephemereal] [-c|--clear|-C|--clear-always] [-i|--interval $(durationWithAdjustmentToSeconds --get-short-usage format)] TIMESPAN [-?|-h|--help]"
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    local timespanFormat="$(durationToSeconds --get-short-usage format 2>/dev/null)"
    cat <<HELPDESCRIPTION
Standin for sleep that prints updates to the terminal as it waits. Pauses for
${timespanFormat:-TIMESPAN}
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --prefix TEXT	Print TEXT before the remaining wait time.
    --as dot		Append a period each interval.
    --as ephemereal	Print (and overwrite) remaining wait times via ANSI
			escape sequences.
    --clear|-c		Clear TEXT and waiting indication after successful
			completion.
    --clear-always|-C	Clear TEXT and waiting indication also when the wait has
			been aborted by the user (via Ctrl-C).
HELPTEXT
    durationWithAdjustmentToSeconds --get-long-usage '--interval|-i' 'Wait TIMESPAN between updates instead of the one second
			default.'
}

prefix='Waiting'
render='ephemereal'
isClear=
interval=1
intervalAdjustment=
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--prefix)	shift; prefix="$1"; shift;;
	--clear|-c)	shift; isClear=t;;
	--clear-always|-C)
			shift; isClear=t; trap 'clear 2>/dev/null' EXIT;;
	--interval|-i)	shift; < <(durationWithAdjustmentToSeconds --no-adjustment -- "${1:?}") IFS=$'\t' read -r interval intervalAdjustment || exit 2; shift;;
	--as)		shift; render="$1"; shift;;
	--)		shift; break;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done
if [ $# -ne 1 ]; then
    printUsage "$0" >&2
    exit 2
fi
delay=$(durationToSeconds -- "${1:?}") || { printf >&2 'ERROR: Illegal TIMESPAN: %s\n' "$1"; exit 2; }; shift

typeset -a ADJUSTER=()
adjustInto()
{
    local -n resultRef="${1:?}"; shift
    local input="${1:?}"; shift

    [ ${#ADJUSTER[@]} -gt 0 ] \
	|| coproc ADJUSTER { durationWithAdjustmentToSeconds; } # Start a coproc to adjust individual timespans and manage expiration; this is much more efficient than starting a new process for each timespan.

    printf '%s\n' "$input" >&"${ADJUSTER[1]}"
    IFS=$'\n' read -r -u "${ADJUSTER[0]}" resultRef \
    || { printf >&2 'ASSERT: Adjustment succeeds: %s\n' "$input"; exit 3; }
    case ",${DEBUG:-}," in *,countdown:adjuster,*) printf >&2 '%scountdown (adjuster): %s -> %s\n' "$PS5" "$input" "$resultRef";; esac
}
adjustInterval()
{
    [ -n "$intervalAdjustment" ] || return 1
    adjustInto interval "${interval}${intervalAdjustment}"
    [ "$interval" != 0 ] || intervalAdjustment=''    # Optimization: Once the timespan has been reduced to zero, it's not gonna increase again, so we can stop adjusting.
}
timeRemaining=
expiry()
{
    local action="${1:?}"; shift
    local actionArgs; [ $# -eq 0 ] || printf -v actionArgs '\t%s' "$@"
    local result; adjustInto result "${action}${actionArgs}"
    if [ "$action" = 'check' ]; then
	timeRemaining=$result
	[ ${timeRemaining:0:1} = - ]
    elif [ "$action" = 'calc' ]; then
	[ "$result" = '1' ]
    fi
}

updateDuration()
{
    local previousDuration="$1"; shift
    local duration="$1"; shift
    local cleaner=

    local durationDiffCnt=$((${#previousDuration} - ${#duration}))
    if [ $durationDiffCnt -gt 0 ]; then
	cleaner="                    "
	cleaner="${cleaner:0:$durationDiffCnt}"
	cleaner+="${cleaner//?/}"
    fi
    printf '%s%s%s' "${previousDuration//?/}" "$duration" "$cleaner"
}

# Force printing directly to terminal, even if stdout is redirected.
{ exec >/dev/tty; } 2>/dev/null || printf() { :; }

[ "$isClear" ] && printf '[s'
clear()
{
    printf '%s' "[u" "[0K"
}

finalizer=
case "$render" in
    dot)	    printf '%s' "$prefix";;
    ephemereal)	    printf '%s' "${prefix}${prefix:+ }"
		    previousDuration=
		    duration=
		    finalizer='updateDuration "${prefix:+ }$duration" ""'
		    ;;
    *)		    printf >&2 'Invalid render: %s\n' "$render"; echo >&2; printUsage "$0" >&2; exit 2;;
esac

expiry set "$delay" "$delay" "$interval"
while ! expiry check
do
    case "$render" in
	dot)	    printf '.';;
	ephemereal) previousDuration="$duration"
		    duration="$("${projectDir}/lib/secondsToDurationSimple.sh" ${timeRemaining:?})"
		    updateDuration "$previousDuration" "$duration"
		    ;;

    esac

    if expiry calc $timeRemaining '<' $interval; then
	# Only wait for the remaining time, not the full interval.
	currentInterval=$timeRemaining
    else
	currentInterval=$interval
	adjustInterval && expiry set "$timeRemaining" "$timeRemaining" "$interval"
    fi
    sleep "$currentInterval" || exit $?
done
[ ${#ADJUSTER[@]} -eq 0 ] || exec {ADJUSTER[1]}>&- {ADJUSTER[0]}<&-; ADJUSTER=()

if [ "$isClear" ]; then
    clear
else
    eval "$finalizer"
    printf '\n'
fi
